{
  "version": 2,
  "rewrites": [
    { "source": "/img", "destination": "/api/img" },
    { "source": "/api/check-hotlink", "destination": "/api/check-hotlink" },
    { "source": "/api/(.*)", "destination": "/api/proxy?path=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
